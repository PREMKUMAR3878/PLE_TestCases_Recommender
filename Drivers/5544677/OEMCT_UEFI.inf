[Strings]
; localizable
DiskName     = "Firmware Update"
Provider     = "Surface OEMCT"
MfgName      = "OEMCT"
FirmwareDesc = "OEMCT UEFI"

; non-localizable
DIRID_WINDOWS = 10
REG_DWORD     = 0x00010001
