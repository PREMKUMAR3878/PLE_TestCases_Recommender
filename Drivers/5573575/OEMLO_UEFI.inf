[Strings]
; localizable
DiskName      = "Firmware Update"
Provider      = "Surface OEMLO"
MfgName       = "OEMLO"
Firmware0Desc = "OEMLO UEFI"
Firmware1Desc = "OEMLO UEFI"

; non-localizable
DIRID_WINDOWS = 10
